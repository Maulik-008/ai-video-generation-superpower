{
  "name": "video-studio-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Code-rendered story videos: three.js in headless Chrome + free text-to-speech + ffmpeg. No accounts, no paid APIs.",
  "type": "module",
  "scripts": {
    "validate": "tsx scripts/validate.ts",
    "tts": "tsx scripts/tts.ts",
    "preview": "tsx scripts/preview.ts",
    "render": "tsx scripts/render.ts",
    "build": "tsx scripts/build.ts",
    "qa": "tsx scripts/qa.ts",
    "typecheck": "tsc --noEmit",
    "voices:setup": "tsx scripts/voices-setup.ts",
    "voices:check": "tsx scripts/voices-check.ts",
    "demo": "tsx scripts/demo.ts",
    "setup": "node ../setup.mjs"
  },
  "dependencies": {
    "esbuild": "0.28.2",
    "ffmpeg-static": "5.3.0",
    "msedge-tts": "2.1.1",
    "puppeteer-core": "25.16.0",
    "three": "0.187.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "0.187.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
